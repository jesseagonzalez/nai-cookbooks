---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import Meta from './Meta.astro';
import { typeLabel } from '~/lib/resources';
const { entry } = Astro.locals.starlightRoute;
const { level, type, duration, date, author, topic } = entry.data;
const eyebrow = [typeLabel(type), topic].filter(Boolean).join(' · ');
---
{eyebrow && <p class="ll-eyebrow ll-title-eyebrow">{eyebrow}</p>}
<Default />
{entry.data.description && type && <p class="ll-lede">{entry.data.description}</p>}
<Meta {level} {duration} {date} {author} id={type && type !== 'guide' ? entry.id : undefined} />
{entry.data.tags.length > 0 && type && type !== 'blog' && (
  <div class="ll-chips ll-title-tags">{entry.data.tags.map((t) => <span class="ll-chip">{t}</span>)}</div>
)}
