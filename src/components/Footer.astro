---
import Default from '@astrojs/starlight/components/Footer.astro';
import { withBase } from '~/lib/url';
import NutanixLogo from './NutanixLogo.astro';
---
<Default />
<div class="ll-footer">
  <a class="ll-footer-logo" href={withBase('/')}>
    <NutanixLogo height={11} />
    <span>Nutanix AI Labs</span>
  </a>
  <p>A field guide to Nutanix Enterprise AI.</p>
  <nav class="ll-footer-links"><a href={withBase("/start-here/overview/")}>About</a><a href={withBase("/contribute/content-guide/")}>Contribute</a><a href="#_top">Back to top ↑</a></nav>
</div>
