---
/**
 * Filterable resource library: format tabs + level / topic / task / tag filters.
 * <ResourceLibrary />                all resources, with format tabs
 * <ResourceLibrary dir="recipes" />  one section, no tabs
 */
import { Image } from 'astro:assets';
import { formats, getResources, typeLabel, cap } from '~/lib/resources';
import { withBase } from '~/lib/url';
import chevron from '~/assets/chevron.png';
import { previewOf } from '~/lib/preview';

interface Props { dir?: string }
const { dir } = Astro.props;
const items = await getResources(dir);
const uniq = (xs: (string | undefined)[]) => [...new Set(xs.filter(Boolean) as string[])].sort((a, b) => a.localeCompare(b));
const topics = uniq(items.map((e) => e.data.topic));
const tasks = uniq(items.map((e) => e.data.task));
const tags = uniq(items.flatMap((e) => e.data.tags));
const tabFor = (t?: string) => formats.find((f) => (f.types as readonly string[]).includes(t ?? ''))?.label ?? '';
const showcase = dir === 'showcase';
---
<div class="ll-library not-content" data-library data-tab-active={showcase ? 'Showcase' : ''}>
  {!dir && (
    <div class="ll-tabs" role="tablist" aria-label="Resource formats">
      {['All resources', ...formats.map((f) => f.label)].map((label, i) => (
        <button type="button" role="tab" data-tab={i === 0 ? '' : label} aria-selected={i === 0 ? 'true' : 'false'}>{label}</button>
      ))}
    </div>
  )}
  <div class="ll-filters">
    <label>Skill level
      <select data-filter="level">
        <option value="">All levels</option>
        <option value="beginner">Beginner</option>
        <option value="intermediate">Intermediate</option>
        <option value="advanced">Advanced</option>
      </select>
    </label>
    {topics.length > 1 && (
      <label>Topic
        <select data-filter="topic"><option value="">All topics</option>{topics.map((t) => <option>{t}</option>)}</select>
      </label>
    )}
    {tasks.length > 1 && (
      <label>Task
        <select data-filter="task"><option value="">All tasks</option>{tasks.map((t) => <option>{t}</option>)}</select>
      </label>
    )}
    {tags.length > 0 && (
      <label>Tags
        <select data-tag-picker><option value="">Add a tag</option>{tags.map((t) => <option>{t}</option>)}</select>
      </label>
    )}
    <button type="button" class="ll-clear" data-clear>Clear filters</button>
    <span class="ll-count" aria-live="polite" data-count></span>
  </div>
  <div class="ll-chips ll-active-tags" data-active-tags aria-label="Active tags" hidden></div>
  <div class="ll-cards">
    {items.map((e) => {
      const href = withBase(`/${e.id}/`);
      const cover = e.data.cover || e.data.coverLabel;
      const pv = previewOf(e.body);
      const openLabel = e.data.type === 'demo' ? 'lab' : e.data.type === 'showcase' ? 'scenario' : 'resource';
      return (
        <article class:list={['ll-card', { 'has-cover': cover }]} data-tab={tabFor(e.data.type)} data-level={e.data.level ?? ''} data-topic={e.data.topic ?? ''} data-task={e.data.task ?? ''} data-tags={JSON.stringify(e.data.tags)} data-id={e.id}>
          {e.data.cover && (
            <a class="ll-cover" href={href} tabindex="-1" aria-hidden="true">
              <Image src={e.data.cover} alt="" widths={[420, 840]} sizes="(max-width: 50rem) 100vw, 25rem" />
            </a>
          )}
          {!e.data.cover && e.data.coverLabel && (
            <a class="ll-cover ll-cover-label" href={href} tabindex="-1" aria-hidden="true">
              <Image src={chevron} alt="" widths={[420, 840]} sizes="25rem" />
              <span>{e.data.type === 'showcase' && e.data.level === 'advanced' ? 'Advanced scenario' : 'Scenario'}<strong>{e.data.coverLabel}</strong></span>
            </a>
          )}
          <div class="ll-card-body">
            <span class="ll-tag">{typeLabel(e.data.type)}</span>
            <h3><a href={href}>{e.data.title}</a></h3>
            <p>{e.data.description}</p>
            {e.data.tags.length > 0 && (
              <div class="ll-chips">{e.data.tags.map((t) => <button type="button" class="ll-chip" data-tag={t} aria-pressed="false">{t}</button>)}</div>
            )}
            <div class="ll-meta">
              <span>{[cap(e.data.level), e.data.duration].filter(Boolean).join(' · ') || e.data.date?.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</span>
              <span>{e.data.topic}</span>
            </div>
            <div class="ll-actions">
              <a href={href}>Open {openLabel} →</a>
              <button type="button" class="ll-preview-btn" data-preview aria-label={`Preview ${e.data.title}`}>Preview</button>
              <span class="ll-done" hidden>✓ Completed</span>
            </div>
          </div>
          <template data-preview-body>
            <p class="ll-eyebrow">{[typeLabel(e.data.type), cap(e.data.level), e.data.duration].filter(Boolean).join(' / ')}</p>
            <h2>{e.data.title}</h2>
            <p class="ll-pv-summary">{e.data.description}</p>
            {e.data.tags.length > 0 && <div class="ll-chips">{e.data.tags.map((t) => <span class="ll-chip">{t}</span>)}</div>}
            {pv.intro && <p>{pv.intro}</p>}
            {pv.sections.length > 0 && (<><h3>What you’ll cover</h3><ul>{pv.sections.map((s) => <li>{s}</li>)}</ul></>)}
            <a class="ll-btn primary" href={href}>Open full {openLabel} →</a>
          </template>
        </article>
      );
    })}
  </div>
  <dialog class="ll-dialog" data-preview-dialog aria-label="Resource preview">
    <div class="ll-dialog-head"><span class="ll-eyebrow">Nutanix AI Labs / Preview</span><button type="button" data-close aria-label="Close preview">✕</button></div>
    <article data-preview-article></article>
  </dialog>
  <p class="ll-empty" hidden data-empty>No resources match these filters. Try another topic, task, tag, or skill level.</p>
</div>

<script>
  const done: string[] = (() => { try { return JSON.parse(localStorage.getItem('latent-progress') || '[]'); } catch { return []; } })();
  document.querySelectorAll<HTMLElement>('[data-library]').forEach((lib) => {
    const cards = [...lib.querySelectorAll<HTMLElement>('.ll-card')];
    cards.forEach((c) => { if (done.includes(c.dataset.id!)) c.querySelector<HTMLElement>('.ll-done')!.hidden = false; });
    const selects = [...lib.querySelectorAll<HTMLSelectElement>('[data-filter]')];
    const picker = lib.querySelector<HTMLSelectElement>('[data-tag-picker]');
    const active = lib.querySelector<HTMLElement>('[data-active-tags]')!;
    const tabs = [...lib.querySelectorAll<HTMLButtonElement>('button[data-tab]')];
    const chosen = new Set<string>();
    let tab = lib.dataset.tabActive ?? '';
    const apply = () => {
      const f = Object.fromEntries(selects.map((s) => [s.dataset.filter!, s.value]));
      let n = 0;
      for (const c of cards) {
        const ctags: string[] = JSON.parse(c.dataset.tags || '[]');
        const show = (!tab || c.dataset.tab === tab)
          && Object.entries(f).every(([k, v]) => !v || c.dataset[k] === v)
          && [...chosen].every((t) => ctags.includes(t));
        c.hidden = !show; if (show) n++;
      }
      lib.dataset.tabActive = tab;
      document.querySelectorAll<HTMLElement>('[data-library-title]').forEach((h) => {
        h.textContent = tab === 'Showcase' ? 'AI Showcase' : 'Explore the resource library';
      });
      document.querySelectorAll<HTMLElement>('[data-library-sub]').forEach((p) => {
        p.textContent = tab === 'Showcase' ? 'Try an interactive lab or step through a sample AI application.' : 'Find resources by topic, task, format, and skill level.';
      });
      lib.querySelector('[data-count]')!.textContent = `${String(n).padStart(2, '0')} ${n === 1 ? 'resource' : 'resources'}`;
      lib.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
      lib.querySelectorAll<HTMLButtonElement>('.ll-chip').forEach((b) => b.setAttribute('aria-pressed', String(chosen.has(b.dataset.tag!))));
      active.hidden = chosen.size === 0;
      active.replaceChildren(...[...chosen].map((t) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'll-chip'; b.dataset.tag = t; b.setAttribute('aria-pressed', 'true');
        b.setAttribute('aria-label', `Remove tag ${t}`); b.textContent = `${t} ×`; return b;
      }));
      if (picker) [...picker.options].forEach((o) => { if (o.value) o.hidden = chosen.has(o.value); });
    };
    const toggle = (t: string) => { chosen.has(t) ? chosen.delete(t) : chosen.add(t); apply(); };
    const dialog = lib.querySelector<HTMLDialogElement>('[data-preview-dialog]')!;
    const article = dialog.querySelector<HTMLElement>('[data-preview-article]')!;
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (ev) => { if (ev.target === dialog) dialog.close(); });
    lib.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const chip = t.closest<HTMLElement>('.ll-cards .ll-chip, [data-active-tags] .ll-chip');
      if (chip?.dataset.tag) { toggle(chip.dataset.tag); return; }
      const btn = t.closest<HTMLElement>('[data-preview]');
      if (btn) {
        const tpl = btn.closest('.ll-card')!.querySelector<HTMLTemplateElement>('template[data-preview-body]')!;
        article.replaceChildren(tpl.content.cloneNode(true));
        dialog.showModal();
      }
    });
    picker?.addEventListener('change', () => { if (picker.value) toggle(picker.value); picker.selectedIndex = 0; });
    const setTab = (t: string) => {
      tab = t;
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === t)));
      apply();
    };
    tabs.forEach((b) => b.addEventListener('click', () => { setTab(b.dataset.tab!); history.replaceState(null, '', b.dataset.tab ? `#${b.dataset.tab.toLowerCase()}` : '#library'); }));
    selects.forEach((s) => s.addEventListener('change', apply));
    lib.querySelector('[data-clear]')!.addEventListener('click', () => { selects.forEach((s) => (s.selectedIndex = 0)); chosen.clear(); apply(); });
    const alias: Record<string, string> = { '#playbooks': '#cookbook', '#demos': '#showcase' };
    const hash = alias[location.hash] ?? location.hash;
    const fromHash = tabs.find((b) => b.dataset.tab && `#${b.dataset.tab.toLowerCase()}` === hash);
    if (tabs.length) setTab(fromHash?.dataset.tab ?? ''); else apply();
  });
</script>
