---
import NutanixLogo from './NutanixLogo.astro';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title sl-flex">
  <NutanixLogo class="site-logo" />
  <span translate="no">{siteTitle}</span>
</a>
<style>
  .site-title { align-items: center; gap: var(--sl-nav-gap); font-size: var(--sl-text-h4); font-weight: 600; color: var(--sl-color-white); text-decoration: none; white-space: nowrap; min-width: 0; }
  span { overflow: hidden; }
  .site-logo { height: 1.05rem; width: auto; flex-shrink: 0; }
</style>
