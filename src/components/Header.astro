---
/** Starlight header plus the Nutanix AI Labs format navigation. */
import Default from '@astrojs/starlight/components/Header.astro';
import { formats } from '~/lib/resources';
import { withBase } from '~/lib/url';
const current = Astro.locals.starlightRoute.entry.id?.split('/')[0] ?? '';
---
<div class="ll-header">
  <Default />
  <nav class="ll-nav" aria-label="Resource formats">
    {formats.map((f) => (
      <a href={withBase(`/${f.dir}/`)} aria-current={current === f.dir ? 'page' : undefined}>{f.label}</a>
    ))}
  </nav>
</div>

<script>
  // Press "/" to open search, like the prototype.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.altKey || e.ctrlKey || e.metaKey) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select, [contenteditable]') || document.querySelector('dialog[open]')) return;
    const open = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
    if (open) { e.preventDefault(); open.click(); }
  });
</script>
